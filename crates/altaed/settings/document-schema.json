{
  "owner": "core",
  "layout": {
    "width": 960,
    "height": 700,
    "sidebar": 192,
    "footer": 52,
    "content_padding": 32,
    "section_header": 36,
    "control_height": 36,
    "multiline_height": 100,
    "row_gap": 28
  },
  "categories": [
    {
      "id": "core.compiler",
      "label": "编译器",
      "description": "从当前编辑内容编译，无需先保存文件。"
    },
    {
      "id": "core.execution",
      "label": "运行",
      "description": "设置本地测试的执行限制。"
    },
    {
      "id": "core.checker",
      "label": "输出比较",
      "description": "为这份代码选择合适的答案比较方式。"
    }
  ],
  "settings": [
    {
      "id": "core.compiler.path",
      "category": "core.compiler",
      "label": "C++ 编译器",
      "description": "留空时从 PATH 查找 clang++、g++ 或 c++。",
      "kind": "text",
      "default": "",
      "placeholder": "自动查找"
    },
    {
      "id": "core.compiler.standard",
      "category": "core.compiler",
      "label": "C++ 标准",
      "description": "选择标准会覆盖参数中的 -std；默认保留手写参数，未指定时由编译器决定。",
      "kind": "choice",
      "default": "default",
      "options": []
    },
    {
      "id": "core.compiler.optimization",
      "category": "core.compiler",
      "label": "优化级别",
      "description": "选择后覆盖附加参数中的 -O 选项；沿用时保留原有参数。",
      "kind": "choice",
      "default": "inherit",
      "options": []
    },
    {
      "id": "core.compiler.warnings",
      "category": "core.compiler",
      "label": "常用警告",
      "description": "加入 -Wall 和 -Wextra，帮助发现可疑代码。",
      "kind": "toggle",
      "default": false
    },
    {
      "id": "core.compiler.debug_info",
      "category": "core.compiler",
      "label": "调试信息",
      "description": "加入 -g，保留调试器和错误报告所需的符号。",
      "kind": "toggle",
      "default": false
    },
    {
      "id": "core.compiler.address_sanitizer",
      "category": "core.compiler",
      "label": "内存错误检查",
      "description": "加入 AddressSanitizer，检测越界和释放后使用；需要编译器及运行库支持。",
      "kind": "toggle",
      "default": false
    },
    {
      "id": "core.compiler.undefined_sanitizer",
      "category": "core.compiler",
      "label": "未定义行为检查",
      "description": "加入 UndefinedBehaviorSanitizer，检测有符号溢出等问题；需要工具链支持。",
      "kind": "toggle",
      "default": false
    },
    {
      "id": "core.compiler.arguments",
      "category": "core.compiler",
      "label": "附加编译参数",
      "description": "每行一个参数，无需 shell 引号。启用的上方选项会在这些参数基础上生效。",
      "kind": "multiline",
      "default": "-O2",
      "placeholder": "每行一个参数"
    },
    {
      "id": "core.compiler.directory",
      "category": "core.compiler",
      "label": "工作目录",
      "description": "留空使用源码所在目录；未保存代码使用应用工作目录。",
      "kind": "text",
      "default": "",
      "placeholder": "源码所在目录"
    },
    {
      "id": "core.execution.compile_timeout",
      "category": "core.execution",
      "label": "编译超时",
      "description": "超过此时间停止本次编译。",
      "kind": "integer",
      "unit": "毫秒",
      "min": 1,
      "default": "30000",
      "control_width": 160
    },
    {
      "id": "core.execution.test_timeout",
      "category": "core.execution",
      "label": "单例超时",
      "description": "每个测试用例独立计时，交互终端不使用此限制。",
      "kind": "integer",
      "unit": "毫秒",
      "min": 1,
      "default": "2000",
      "control_width": 160
    },
    {
      "id": "core.execution.output_limit",
      "category": "core.execution",
      "label": "输出上限",
      "description": "标准输出与错误输出的合计上限。",
      "kind": "integer",
      "unit": "字节",
      "min": 1,
      "default": "1048576",
      "control_width": 160
    },
    {
      "id": "core.execution.test_data_limit",
      "category": "core.execution",
      "label": "测试数据总上限",
      "description": "一次测试读取的输入与预期输出总大小，包含绑定文件。避免大数据占用过多内存。",
      "kind": "integer",
      "unit": "字节",
      "min": 1,
      "default": "67108864",
      "control_width": 180
    },
    {
      "id": "core.checker.mode",
      "category": "core.checker",
      "label": "比较方式",
      "description": "预期输出有内容时自动比较；留空仅观察输出。",
      "kind": "choice",
      "default": "trimmed",
      "options": [
        {
          "value": "trimmed",
          "label": "忽略行末空格和文末换行"
        },
        {
          "value": "exact",
          "label": "严格一致"
        },
        {
          "value": "ncmp",
          "label": "ncmp · 匹配 64 位整数"
        },
        {
          "value": "rcmp4",
          "label": "rcmp4 · 匹配浮点数，最大误差 1e-4"
        },
        {
          "value": "rcmp6",
          "label": "rcmp6 · 匹配浮点数，最大误差 1e-6"
        },
        {
          "value": "rcmp9",
          "label": "rcmp9 · 匹配浮点数，最大误差 1e-9"
        },
        {
          "value": "tokens",
          "label": "wcmp · 匹配字符串"
        },
        {
          "value": "nyesno",
          "label": "nyesno · 匹配 YES 和 NO，大小写不敏感"
        },
        {
          "value": "float",
          "label": "自定义浮点容差"
        },
        {
          "value": "executable",
          "label": "外部比较器"
        }
      ]
    },
    {
      "id": "core.checker.absolute",
      "category": "core.checker",
      "label": "绝对误差",
      "description": "实际值与预期值允许的最大绝对差。",
      "kind": "decimal",
      "min": 0,
      "default": "0.000001",
      "visible_when": {
        "id": "core.checker.mode",
        "value": "float"
      },
      "control_width": 160
    },
    {
      "id": "core.checker.relative",
      "category": "core.checker",
      "label": "相对误差",
      "description": "满足绝对误差或相对误差中的任一条件即通过。",
      "kind": "decimal",
      "min": 0,
      "default": "0.000001",
      "visible_when": {
        "id": "core.checker.mode",
        "value": "float"
      },
      "control_width": 160
    },
    {
      "id": "core.checker.program",
      "category": "core.checker",
      "label": "比较器文件",
      "description": "现成的原生可执行文件，按 testlib 顺序接收输入、实际输出、预期输出三个文件路径。也可从测试栏导入。",
      "kind": "text",
      "default": "",
      "required": true,
      "visible_when": {
        "id": "core.checker.mode",
        "value": "executable"
      },
      "control_width": 360
    },
    {
      "id": "core.checker.timeout",
      "category": "core.checker",
      "label": "比较器超时",
      "description": "每个用例独立计时，超时报告为比较器错误。",
      "kind": "integer",
      "default": "2000",
      "min": 1,
      "unit": "ms",
      "visible_when": {
        "id": "core.checker.mode",
        "value": "executable"
      },
      "control_width": 160
    },
    {
      "id": "core.checker.arguments",
      "category": "core.checker",
      "label": "附加参数",
      "description": "每行一个参数，追加在三个文件路径之后；不经过 shell 解析。",
      "kind": "multiline",
      "default": "",
      "visible_when": {
        "id": "core.checker.mode",
        "value": "executable"
      },
      "control_width": 360
    }
  ]
}
